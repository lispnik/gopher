;;;; docstrings.lisp -- documentation for accessors, predicates and types.
;;;;
;;;; DEFSTRUCT and slot readers can't carry docstrings where they are
;;;; defined, so they get them here, in one table.  docs/generate.lisp turns
;;;; all docstrings into docs/API.md.

(in-package #:gopher)

(defparameter *function-docs*
  '(;; URLs
    (url-scheme "The scheme, lowercased: \"gopher\", \"gemini\" ...")
    (url-userinfo "The user part before `@', percent-encoded, or NIL.")
    (url-host "The host, lowercased; international names in their xn-- ASCII form.")
    (url-port "The explicit port, or NIL for the scheme's default (see URL-EFFECTIVE-PORT).")
    (url-path "The path, percent-encoded as written.  For Gopher: /<type><selector>.")
    (url-query "The query without `?', percent-encoded, or NIL.  Always NIL for Gopher.")
    (url-fragment "The fragment without `#', or NIL.  Never sent to a server.")
    (url-p "True if the object is a URL.")
    (copy-url "A fresh copy of a URL.")
    ;; certificates
    (certificate-fingerprint "SHA-256 fingerprint as \"sha256:<64 hex digits>\".")
    (certificate-not-before "Universal time from which the certificate is valid, or NIL.")
    (certificate-not-after "Universal time at which the certificate expires, or NIL.")
    (certificate-common-names "The subject's CN values.")
    (certificate-dns-names "The DNS subjectAltName entries (may be empty).")
    (certificate-expired-p "True if the certificate's not-after time has passed.")
    (certificate-info-p "True if the object is a CERTIFICATE-INFO.")
    ;; known hosts
    (known-host-host "Host name of a KNOWN-HOST entry.")
    (known-host-port "Port of a KNOWN-HOST entry.")
    (known-host-fingerprint "Trusted certificate fingerprint, \"sha256:...\".")
    (known-host-expires "Universal time the trusted certificate expires, or NIL.")
    (known-host-first-seen "Universal time the entry was recorded.")
    (known-host-p "True if the object is a KNOWN-HOST.")
    (make-known-host "Make a KNOWN-HOST entry: :HOST :PORT :FINGERPRINT :EXPIRES :FIRST-SEEN.")
    (make-memory-known-hosts "A known-hosts store that lives only in memory.")
    (make-file-known-hosts "A known-hosts store loaded from and saved to PATHNAME.")
    (known-hosts-pathname "The file a FILE-KNOWN-HOSTS store uses.")
    ;; cancellation
    (make-request-handle "A handle to pass as FETCH's :HANDLE so CANCEL-REQUEST can stop the fetch.")
    (request-handle-cancelled-p "True once CANCEL-REQUEST has been called on the handle.")
    ;; conditions
    (error-url "The URL (or string) the failing request was for, or NIL.")
    (error-message "A human-readable description of the failure.")
    (error-limit "The MAX-SIZE that was exceeded.")
    (error-scheme "The scheme that has no handler.")
    (mismatch-host "Host whose certificate changed.")
    (mismatch-port "Port whose certificate changed.")
    (mismatch-expected "The KNOWN-HOST entry on record.")
    (mismatch-certificate "The CERTIFICATE-INFO the server presented.")
    ;; documents
    (document-kind "What the document was parsed from: :MENU :GEMTEXT :NEX-DIRECTORY or :TEXT.")
    (document-lines "Vector of DOCUMENT-LINEs, in order.")
    (document-title "The first level-1 heading of a gemtext document, or NIL.")
    (document-p "True if the object is a DOCUMENT.")
    (document-line-p "True if the object is a DOCUMENT-LINE.")
    (make-document-line "Make a DOCUMENT-LINE.  Keys: :KIND :TEXT :URL :LEVEL :ALT :ITEM-TYPE :ITEM-KIND :GOPHER-PLUS-P :HOST :PORT :SELECTOR.")
    (line-kind "One of :TEXT :LINK :INPUT-PROMPT :HEADING :LIST-ITEM :QUOTE :PREFORMATTED :ERROR.")
    (line-text "The line's text; for links, the label.")
    (line-url "For links and prompts, the absolute URL as a string.")
    (line-level "Heading level 1-3, for :HEADING lines.")
    (line-alt "Alt text of a gemtext preformatted block, or NIL.")
    (line-item-type "Gopher item type character, for lines from a menu.")
    (line-item-kind "Gopher item classification keyword, see GOPHER-ITEM-KIND.")
    (line-gopher-plus-p "True if the menu marked the item as Gopher+.")
    (line-gopher-plus-ask-p "True if the menu marked the item with `?': a Gopher+ item
with a +ASK form to answer before fetching it (see GOPHER-PLUS-SUBMIT).")
    (line-host "Gopher items: the host field of the menu line.")
    (line-port "Gopher items: the port field of the menu line.")
    (line-selector "Gopher items: the selector field of the menu line.")
    ;; responses
    (response-url "The URL that produced the response (after redirects).")
    (response-protocol "Keyword: :GOPHER :GEMINI :TITAN :SPARTAN :NEX :GUPPY or :FINGER.")
    (response-status "Status keyword: :SUCCESS :INPUT :SENSITIVE-INPUT :REDIRECT :NOT-FOUND ...")
    (response-status-code "The protocol's own status number (e.g. Gemini's 51), or NIL.")
    (response-category "The status reduced to :SUCCESS :INPUT :REDIRECT :TEMPORARY-FAILURE :PERMANENT-FAILURE or :CLIENT-CERTIFICATE.")
    (response-meta "Gemini-style meta: MIME type, prompt, redirect target or error text.")
    (response-mime-type "The body's MIME type (with parameters), or NIL.")
    (response-body "The body as octets, or NIL (no body, or it went to a :SINK).")
    (response-bytes-read "How many body bytes were received.")
    (response-certificate "The server's CERTIFICATE-INFO, for TLS responses.")
    (response-trust "How the certificate was trusted: :NEW :TRUSTED :CHANGED :EXPIRED-REPLACED :UNVERIFIED, or NIL.")
    (response-redirects "URL strings that redirected to this response, oldest first.")
    (response-success-p "True for a :SUCCESS response.")
    (response-input-p "True if the server asked for input (:INPUT or :SENSITIVE-INPUT).")
    (response-sensitive-input-p "True if the server asked for sensitive input such as a password.")
    (response-redirect-p "True for a redirect response.")
    ;; gopher
    (gopher-item-description "A short English description of a Gopher item type.")
    (gopher-plus-record-info "The item's +INFO line as a DOCUMENT-LINE.")
    (gopher-plus-record-blocks "All attribute blocks as ((NAME . LINES) ...).")
    (gopher-plus-record-abstract "The +ABSTRACT block as one string, or NIL.")
    (gopher-plus-record-p "True if the object is a GOPHER-PLUS-RECORD.")
    (gopher-plus-view-mime-type "MIME type of a Gopher+ view.")
    (gopher-plus-view-language "Language of a view, e.g. \"En_US\", or NIL.")
    (gopher-plus-view-size "The size as the server wrote it, e.g. \"<10k>\", or NIL.")
    (gopher-plus-view-p "True if the object is a GOPHER-PLUS-VIEW.")
    (gopher-plus-question-kind "One of :ASK :ASK-PASSWORD :ASK-LONG :ASK-FILE :SELECT :CHOOSE :CHOOSE-FILE :NOTE.")
    (gopher-plus-question-prompt "The question text.")
    (gopher-plus-question-choices "Default answer (:ASK) or the options (:SELECT, :CHOOSE).")
    (gopher-plus-question-p "True if the object is a GOPHER-PLUS-QUESTION.")
    ;; registry
    (find-scheme-handler "The handler function for a scheme string, or NIL.")
    (supported-schemes "Every scheme FETCH can handle, sorted.")
    ;; cache and history
    (cache-clear "Empty the cache.")
    (cache-count "Number of responses in the cache.")
    (make-history "An empty back/forward history.")
    (history-current "The current URL string, or NIL before the first visit.")
    (history-back-p "True if HISTORY-BACK would move.")
    (history-forward-p "True if HISTORY-FORWARD would move.")))

(defparameter *type-docs*
  '((url "A parsed URL.  Make one with PARSE-URL or MAKE-URL.")
    (document "A parsed page: kind, title and a vector of DOCUMENT-LINEs.")
    (document-line "One line of a DOCUMENT; see LINE-KIND.")
    (response "Everything a FETCH returned: status, meta, body, certificate.")
    (request-handle "Lets another thread cancel a FETCH; see CANCEL-REQUEST.")
    (known-host "A trusted certificate fingerprint for one host:port.")
    (gopher-plus-record "One item's Gopher+ attributes.")
    (gopher-plus-view "One entry of a +VIEWS block.")
    (gopher-plus-question "One question of a Gopher+ +ASK form.")
    (line-parser "Parses a text format one line at a time; see MAKE-LINE-PARSER.")
    (response-cache "A size-bounded LRU cache of responses; see MAKE-RESPONSE-CACHE.")
    (history "A back/forward list of visited URLs.")))

(loop for (name doc) in *function-docs*
      do (setf (documentation name 'function) doc))
(loop for (name doc) in *type-docs*
      do (setf (documentation name 'type) doc))
(setf (documentation '*default-max-redirects* 'variable)
      "How many redirects FETCH follows by default.")
(loop for (name doc) in *type-docs*
      do (setf (documentation (find-class name) t) doc))
